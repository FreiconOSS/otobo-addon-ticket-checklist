<?xml version="1.0" encoding="utf-8"?>
<otobo_package version="1.0">
    <Name>TicketChecklist</Name>
    <Framework>11.0.x</Framework>
    <Vendor>Perl-Services.de</Vendor>
    <URL>http://www.perl-services.de</URL>
    <Description Lang="de">Eine Checkliste für Tickets.</Description>
    <Description Lang="en">Add a checklist to tickets.</Description>
    <Description Lang="hu">Egy ellenőrzőlista hozzáadása a jegyekhez.</Description>
    <License>GNU AFFERO GENERAL PUBLIC LICENSE Version 3, November 2007</License>
    <DatabaseInstall Type="post">
        <TableCreate Name="ps_ticketchecklist_status">
            <Column Name="id" Required="true" Type="INTEGER" AutoIncrement="true" PrimaryKey="true"/>
            <Column Name="name" Required="true" Type="VARCHAR" Size="150"/>
            <Column Name="color" Required="true" Type="VARCHAR" Size="10"/>
            <Column Name="valid_id" Required="true" Type="SMALLINT"/>
            <Column Name="queues" Required="false" Type="VARCHAR" Size="1000"/>
            <Column Name="roles" Required="false" Type="VARCHAR" Size="1000"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <ForeignKey ForeignTable="users">
                <Reference Local="create_by" Foreign="id"/>
                <Reference Local="change_by" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="valid">
                <Reference Local="valid_id" Foreign="id"/>
            </ForeignKey>
        </TableCreate>
        <TableCreate Name="ps_ticketchecklist">
            <Column Name="id" Required="true" Type="INTEGER" AutoIncrement="true" PrimaryKey="true"/>
            <Column Name="title" Required="false" Type="VARCHAR" Size="250"/>
            <Column Name="comments" Required="false" Type="VARCHAR" Size="5000"/>
            <Column Name="position" Required="true" Type="SMALLINT"/>
            <Column Name="status_id" Required="true" Type="INTEGER"/>
            <Column Name="ticket_id" Required="true" Type="BIGINT"/>
            <Column Name="priority_id" Required="true" Type="SMALLINT"/>
            <Column Name="responsible_id" Required="false" Type="INTEGER"/>
            <Column Name="responsible_key" Required="false" Type="VARCHAR" Size="250"/>
            <Column Name="due_date" Required="false" Type="DATE"/>
            <Column Name="date_start" Required="false" Type="DATE"/>
            <Column Name="article_id" Required="false" Type="INTEGER"/>
            <Column Name="article_number" Required="false" Type="VARCHAR" Size="30"/>
            <Column Name="foreign_ticket_id" Required="false" Type="INTEGER"/>
            <Column Name="change_notes" Required="false" Type="VARCHAR" Size="10000"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Column Name="state_change_by" Required="false" Type="INTEGER"/>
            <ForeignKey ForeignTable="users">
                <Reference Local="create_by" Foreign="id"/>
                <Reference Local="change_by" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="ps_ticketchecklist_status">
                <Reference Local="status_id" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="ticket_priority">
                <Reference Local="priority_id" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="ticket">
                <Reference Local="ticket_id" Foreign="id"/>
            </ForeignKey>
        </TableCreate>
        <TableCreate Name="ps_checklist_template">
            <Column Name="id" Required="true" Type="INTEGER" AutoIncrement="true" PrimaryKey="true"/>
            <Column Name="tmpl_name" Required="true" Type="VARCHAR" Size="150"/>
            <Column Name="cl_template" Required="true" Type="VARCHAR" Size="10000"/>
            <Column Name="condition_actions" Required="false" Type="VARCHAR" Size="10000"/>
            <Column Name="valid_id" Required="true" Type="SMALLINT"/>
            <Column Name="customer_ids" Required="false" Type="VARCHAR" Size="10000"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Unique Name="tmpl_name">
                <UniqueColumn Name="tmpl_name"/>
            </Unique>
            <ForeignKey ForeignTable="users">
                <Reference Local="create_by" Foreign="id"/>
                <Reference Local="change_by" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="valid">
                <Reference Local="valid_id" Foreign="id"/>
            </ForeignKey>
        </TableCreate>
        <TableCreate Name="ps_checklist_tmpl_grp">
            <Column Name="template_id" Required="true" Type="INTEGER"/>
            <Column Name="group_id" Required="true" Type="INTEGER"/>
            <Unique Name="template_id_group_id">
                <UniqueColumn Name="template_id"/>
                <UniqueColumn Name="group_id"/>
            </Unique>
            <ForeignKey ForeignTable="ps_checklist_template">
                <Reference Local="template_id" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="groups_table">
                <Reference Local="group_id" Foreign="id"/>
            </ForeignKey>
        </TableCreate>
        <TableCreate Name="ps_checklist_notify">
            <Column Name="id" Required="true" Type="INTEGER" AutoIncrement="true" PrimaryKey="true"/>
            <Column Name="notification_type" Required="true" Type="VARCHAR" Size="200"/>
            <Column Name="language" Required="true" Type="VARCHAR" Size="60"/>
            <Column Name="subject" Required="true" Type="VARCHAR" Size="200"/>
            <Column Name="notification_text" Required="true" Type="VARCHAR" Size="5000"/>
            <Column Name="content_type" Required="true" Type="VARCHAR" Size="250"/>
            <Column Name="valid_id" Required="true" Type="SMALLINT"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Unique Name="notification_type_language">
                <UniqueColumn Name="notification_type"/>
                <UniqueColumn Name="language"/>
            </Unique>
            <ForeignKey ForeignTable="valid">
                <Reference Local="valid_id" Foreign="id"/>
            </ForeignKey>
        </TableCreate>
        <TableCreate Name="ps_checklist_ticket_info">
            <Column Name="ticket_id" Required="true" Type="BIGINT"/>
            <Column Name="customer_visibility" Required="true" Type="INTEGER"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Unique Name="ticket_id">
                <UniqueColumn Name="ticket_id"/>
            </Unique>
            <ForeignKey ForeignTable="users">
                <Reference Local="create_by" Foreign="id"/>
                <Reference Local="change_by" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="ticket">
                <Reference Local="ticket_id" Foreign="id"/>
            </ForeignKey>
        </TableCreate>
        <Insert Table="ps_ticketchecklist_status">
            <Data Key="name" Type="Quote"><![CDATA[open]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="color" Type="Quote"><![CDATA[#CDCDCD]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_ticketchecklist_status">
            <Data Key="name" Type="Quote"><![CDATA[done]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="color" Type="Quote"><![CDATA[#8BEF4D]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_ticketchecklist_status">
            <Data Key="name" Type="Quote"><![CDATA[rejected]]></Data>
            <Data Key="color" Type="Quote"><![CDATA[#FF505E]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
            <Data Key="valid_id">1</Data>
        </Insert>
        <Insert Table="ps_ticketchecklist_status">
            <Data Key="name" Type="Quote"><![CDATA[waiting]]></Data>
            <Data Key="color" Type="Quote"><![CDATA[#FFDD50]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
            <Data Key="valid_id">1</Data>
        </Insert>
        <Insert Table="ps_ticketchecklist_status">
            <Data Key="name" Type="Quote"><![CDATA[in progress]]></Data>
            <Data Key="color" Type="Quote"><![CDATA[#FFDD50]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
            <Data Key="valid_id">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemResponsibleUpdate]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Verantwortung einer Aufgabe an Sie übertragen]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo <OTRS_CHECKLISTITEM_User>,

Die Verantwortung eines Checklisten-Punkts im Ticket [<OTRS_TICKET_TicketNumber>] wurde an Sie
von <OTRS_CURRENT_UserFirstname> <OTRS_CURRENT_UserLastname> uebertragen.

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemStatusUpdate]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Statusupdate einer Aufgabe]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo,

Der Status der Aufgabe '<OTRS_CHECKLISTITEM_Title>' im Ticket [<OTRS_TICKET_TicketNumber>] 
wurde auf <OTRS_CHECKLISTITEM_Status> gesetzt.

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemDueDateBefore]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Fälligkeitsdatum einer Aufgabe steht bevor]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo,

Das Fälligkeitsdatum der Aufgabe '<OTRS_CHECKLISTITEM_Title>' im Ticket [<OTRS_TICKET_TicketNumber>] 
steht kurz bevor.

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ticket_history_type">
            <Data Key="name" Type="Quote"><![CDATA[TicketChecklistItemAdd]]></Data>
            <Data Key="comments" Type="Quote"><![CDATA[Added a new checklist item]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ticket_history_type">
            <Data Key="name" Type="Quote"><![CDATA[TicketChecklistItemDelete]]></Data>
            <Data Key="comments" Type="Quote"><![CDATA[Deleted a new checklist item]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ticket_history_type">
            <Data Key="name" Type="Quote"><![CDATA[TicketChecklistItemDueDateUpdate]]></Data>
            <Data Key="comments" Type="Quote"><![CDATA[Updated due date for a checklist item]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ticket_history_type">
            <Data Key="name" Type="Quote"><![CDATA[TicketChecklistItemStatusUpdate]]></Data>
            <Data Key="comments" Type="Quote"><![CDATA[Updated status for a checklist item]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ticket_history_type">
            <Data Key="name" Type="Quote"><![CDATA[TicketChecklistItemResponsibleUpdate]]></Data>
            <Data Key="comments" Type="Quote"><![CDATA[Updated responsible person for a checklist item]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ticket_history_type">
            <Data Key="name" Type="Quote"><![CDATA[TicketChecklistItemDueDateBefore]]></Data>
            <Data Key="comments" Type="Quote"><![CDATA[Reached due date for a checklist item]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time" Type="Quote"><![CDATA[2012-10-18 00:00:00]]></Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemDelete]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Aufgabe gelöscht]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo,

die Aufgabe '<OTRS_CHECKLISTITEM_Title>' im Ticket [<OTRS_TICKET_TicketNumber>] 
wurde gelöscht

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemChangeNote]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Aufgabe verändert]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo <OTRS_CHECKLISTITEM_User>,

folgende Notiz wurde bei der Änderung der Aufgabe angegeben:
<OTRS_CHECKLIST_VARIABLETEXT>

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemChangeNote]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[en]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Note for TODO item change]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hello <OTRS_CHECKLISTITEM_User>,

this note was left when the todo item was changed:
<OTRS_CHECKLIST_VARIABLETEXT>

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Your OTRS notification master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemsAllClosed]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Alle Aufgaben geschlossen]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo,

Alle Aufgaben im Ticket [<OTRS_TICKET_TicketNumber>] sind geschlossen.

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ticket_history_type">
            <Data Key="name" Type="Quote"><![CDATA[TicketChecklistItemMove]]></Data>
            <Data Key="comments" Type="Quote"><![CDATA[Moved to a new ticket]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemDateStartUpdate]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Startdatum einer Aufgabe aktualisiert]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo <OTRS_CHECKLISTITEM_User>,

Das Startdatum eines Checklisten-Punkts im Ticket [<OTRS_TICKET_TicketNumber>] wurde 
von <OTRS_CURRENT_UserFirstname> <OTRS_CURRENT_UserLastname> aktualisiert.

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
        <Insert Table="ps_checklist_notify">
            <Data Key="notification_type" Type="Quote"><![CDATA[ItemDateStartBefore]]></Data>
            <Data Key="language" Type="Quote"><![CDATA[de]]></Data>
            <Data Key="subject" Type="Quote"><![CDATA[Startdatum einer Aufgabe steht bevor]]></Data>
            <Data Key="notification_text" Type="Quote"><![CDATA[Hallo,

Das Startdatum der Aufgabe '<OTRS_CHECKLISTITEM_Title>' im Ticket [<OTRS_TICKET_TicketNumber>] 
steht kurz bevor.

<OTRS_CONFIG_HttpType>://<OTRS_CONFIG_FQDN>/<OTRS_CONFIG_ScriptAlias>index.pl?Action=AgentTicketZoom;TicketID=<OTRS_TICKET_TicketID>

Ihr OTRS Benachrichtigungs-Master]]></Data>
            <Data Key="valid_id">1</Data>
            <Data Key="content_type" Type="Quote"><![CDATA[text/plain]]></Data>
            <Data Key="create_time">current_timestamp</Data>
            <Data Key="create_by">1</Data>
            <Data Key="change_time">current_timestamp</Data>
            <Data Key="change_by">1</Data>
        </Insert>
    </DatabaseInstall>
    <DatabaseUpgrade Type="post">
        <TableCreate Name="ps_checklist_template" Version="3.3.8">
            <Column Name="id" Required="true" Type="INTEGER" AutoIncrement="true" PrimaryKey="true"/>
            <Column Name="tmpl_name" Required="true" Type="VARCHAR" Size="150"/>
            <Column Name="cl_template" Required="true" Type="VARCHAR" Size="10000"/>
            <Column Name="condition_actions" Required="false" Type="VARCHAR" Size="10000"/>
            <Column Name="valid_id" Required="true" Type="SMALLINT"/>
            <Column Name="customer_ids" Required="false" Type="VARCHAR" Size="10000"/>
            <Column Name="create_time" Required="true" Type="DATE"/>
            <Column Name="create_by" Required="true" Type="INTEGER"/>
            <Column Name="change_time" Required="true" Type="DATE"/>
            <Column Name="change_by" Required="true" Type="INTEGER"/>
            <Unique Name="tmpl_name">
                <UniqueColumn Name="tmpl_name"/>
            </Unique>
            <ForeignKey ForeignTable="users">
                <Reference Local="create_by" Foreign="id"/>
                <Reference Local="change_by" Foreign="id"/>
            </ForeignKey>
            <ForeignKey ForeignTable="valid">
                <Reference Local="valid_id" Foreign="id"/>
            </ForeignKey>
