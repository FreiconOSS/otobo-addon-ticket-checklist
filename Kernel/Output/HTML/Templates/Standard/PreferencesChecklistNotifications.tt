<table class="DataTable NotificationList">
    <thead>
        <tr>
            <th>[% Translate("Notification") | html %]</th>
            <th class="Center">[% Translate("Subscribe") | html%]</th>
        </tr>
    </thead>
    <tbody>
[% RenderBlockStart("ChecklistNotification") %]
        <tr title="[% Data.Notification %]">
            <td>[% Translate(Data.NotificationName) | html %]</td>
            <td class="Center">
                <input autocomplete="off" type="checkbox" class="NotificationEvent" name="[% Data.Notification | html %]" title="[% Translate("Receive messages for notification '%s'", Translate(Data.NotificationName)) | html %]" value="1" [% IF Data.Checked == 1 %]checked="checked"[% END %] />
            </td>
        </tr>
[% RenderBlockEnd("ChecklistNotification") %]
    </tbody>
</table>
