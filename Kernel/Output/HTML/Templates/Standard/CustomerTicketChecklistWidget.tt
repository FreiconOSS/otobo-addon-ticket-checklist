<div class="oooSection">
    <h3>[% Translate("Ticket Checklist") | html %]</h3>
    <ul id="CustomerTicketChecklist">
[% RenderBlockStart("Item") %]
        <li><span class="Key">[% Data.Title | html %]:</span>
            <span class="ChecklistStatus" style="background-color: [% Data.Color | html %]">[% Data.StatusSelect %]</span>
        </li>
[% RenderBlockEnd("Item") %]
    </ul>
</div>
